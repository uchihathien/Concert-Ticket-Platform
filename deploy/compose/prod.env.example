# Mẫu biến môi trường cho `prod.yml`.
#
#   cp prod.env.example .env && $EDITOR .env
#
# `.env` KHÔNG được commit — `deploy/compose/.env` nằm trong .gitignore. File này thì có, và vì
# vậy mọi giá trị dưới đây là chỗ trống hoặc ví dụ vô hại, không phải mật khẩu thật.
#
# SINH BÍ MẬT: openssl rand -base64 32
# Mỗi dòng một giá trị RIÊNG. Dùng lại một chuỗi cho nhiều mục đích nghĩa là một lần lộ làm hỏng
# tất cả những mục đích đó cùng lúc.

# --- Địa chỉ công khai -------------------------------------------------------
# Phải là https ở internet thật. Đây là origin mà trình duyệt nhìn thấy, không phải tên trong
# mạng docker.
WEB_CUSTOMER_URL=https://concertth.site
WEB_ADMIN_URL=https://to-chuc.concertth.site
WEB_SCANNER_URL=https://soat-ve.concertth.site
WEB_PLATFORM_URL=https://quan-tri.concertth.site
PUBLIC_API_BASE_URL=https://api.concertth.site
KEYCLOAK_HOSTNAME=https://tai-khoan.concertth.site
OIDC_ISSUER=https://tai-khoan.concertth.site/realms/nexaticket
# Địa chỉ Keycloak nhìn từ TRONG mạng docker. Khác OIDC_ISSUER, và cố ý: identity-service gọi
# Admin API bằng đường nội bộ, không vòng ra internet.
OIDC_BASE_URL=http://keycloak:8080

# --- Bí mật nền tảng ---------------------------------------------------------
# Cho /internal/**. Trống thì service TỪ CHỐI khởi động (ProductionHardening).
INTERNAL_SHARED_SECRET=

# Ai được cấp SUPER_ADMIN ở lần đăng nhập đầu. Không có thì không ai tạo được tổ chức đầu tiên,
# và toàn bộ luồng onboarding trả 403. Đặt email THẬT, không phải superadmin@nexaticket.local —
# ProductionHardening chặn đúng giá trị mặc định đó.
SUPER_ADMIN_EMAILS=

# --- Database ----------------------------------------------------------------
# Mỗi service một user riêng (ADR-1002). CHỈ có tác dụng ở lần khởi tạo đầu tiên, lúc thư mục dữ
# liệu còn rỗng; sau đó đổi bằng ALTER USER.
POSTGRES_SUPERUSER_PASSWORD=
DB_PASSWORD_IDENTITY=
DB_PASSWORD_CATALOG=
DB_PASSWORD_INVENTORY=
DB_PASSWORD_ORDERING=
DB_PASSWORD_PAYMENT=
# Sổ cái có HAI role: owner chạy Flyway, app chạy service. Đây là thứ làm cho sổ cái thật sự
# append-only — owner bỏ qua mọi REVOKE trên bảng của chính mình (ADR-1005).
DB_PASSWORD_LEDGER_OWNER=
DB_PASSWORD_LEDGER_APP=
DB_PASSWORD_PAYOUT=
DB_PASSWORD_TICKETING=
DB_PASSWORD_NOTIFICATION=
DB_PASSWORD_ANALYTICS=
DB_PASSWORD_AI_CHATBOX=
DB_PASSWORD_KEYCLOAK=

# --- Redis, RabbitMQ ---------------------------------------------------------
REDIS_PASSWORD=
RABBITMQ_USER=nexaticket
RABBITMQ_PASSWORD=

# --- Keycloak ----------------------------------------------------------------
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
# Secret của bốn client app + service account của identity. Sinh riêng từng cái, rồi dán CÙNG
# giá trị vào Keycloak (realm import đọc chính các biến này, nên chỉ cần điền ở đây).
KC_SECRET_WEB_CUSTOMER=
KC_SECRET_WEB_ADMIN=
KC_SECRET_WEB_SCANNER=
KC_SECRET_WEB_PLATFORM=
KC_SECRET_IDENTITY_ADMIN=

# --- Auth.js -----------------------------------------------------------------
# Mỗi app một secret. Dùng chung thì cookie phiên của app khách giải mã được ở app quản trị.
AUTH_SECRET_WEB_CUSTOMER=
AUTH_SECRET_WEB_ADMIN=
AUTH_SECRET_WEB_SCANNER=
AUTH_SECRET_WEB_PLATFORM=

# --- Email -------------------------------------------------------------------
# Dùng cho CẢ Keycloak (thư đặt lại mật khẩu) lẫn notification-service (vé, xác nhận đơn).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=no-reply@concertth.site
SMTP_USER=
SMTP_PASSWORD=

# --- Kho ảnh (SeaweedFS, giao thức S3) ---------------------------------------
# HAI địa chỉ khác nhau, và đây là chỗ dễ sai nhất của cả file:
#   MEDIA_ENDPOINT   (khai cứng trong prod.yml) — catalog gọi qua mạng nội bộ compose.
#   MEDIA_PUBLIC_URL (dưới đây)                — TRÌNH DUYỆT gọi, nên phải là tên miền thật có https.
#
# Chữ ký của presigned URL bao gồm cả tên host. Khai nhầm thành `objectstore:9000` thì trình duyệt
# nhận một URL vừa không phân giải được vừa sai chữ ký — và thông báo lỗi không nói gì về nguyên nhân.
MEDIA_PUBLIC_URL=https://media.concertth.site

# Origin được phép tải ảnh lên. Là app THỰC HIỆN upload, không phải app hiển thị ảnh:
# ban tổ chức tải ảnh bìa từ web-admin. Thêm quan-tri nếu Tổng công ty cũng tải ảnh.
MEDIA_CORS_ORIGIN=https://to-chuc.concertth.site

# Khoá của kho ảnh tự vận hành — KHÔNG phải khoá AWS. Sinh như mọi bí mật khác.
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=

# --- payOS -------------------------------------------------------------------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
# Ký và kiểm chữ ký webhook. Sai khoá này thì mọi khoản tiền phải xác nhận tay bằng lệnh reconcile.
PAYOS_CHECKSUM_KEY=

# --- Vận hành ----------------------------------------------------------------
REGISTRY=nexaticket
# Hai tag riêng: backend và frontend là hai repo, hai SHA. CI ghi đè hai biến này lúc deploy;
# giá trị ở đây chỉ là mặc định cho lần dựng bằng tay.
BACKEND_TAG=latest
FRONTEND_TAG=latest
# Tag của ảnh RabbitMQ dựng TẠI CHỖ (plugin delayed message — ADR-1009). Không nằm trên registry,
# nên nó cố tình KHÔNG đi theo BACKEND_TAG: đi theo thì mỗi lần deploy backend lại recreate broker,
# ngắt kết nối mọi consumer để đổi sang một ảnh giống y hệt.
RABBITMQ_TAG=local
LOG_LEVEL=INFO
SERVICE_MEMORY=768m
APP_MEMORY=512m
GATEWAY_PORT=8080
KEYCLOAK_PORT=8081
# Số proxy tin cậy đứng TRƯỚC gateway. Đếm đúng: mỗi lớp (CDN, ingress, load balancer) là một.
# Sai số này thì rate limit hoặc vô hiệu, hoặc dồn cả internet vào chung một hạn mức.
TRUSTED_PROXY_COUNT=1
# Trace. Bat bang TRACING_ENABLED=true, va chi bat khi da co collector nghe o OTEL_ENDPOINT.
OTEL_ENDPOINT=
OTEL_SAMPLE_RATE=0.1

# --- Trợ lý hỗ trợ khách hàng (ai-chatbox-service) ---------------------------
# `local` dùng Ollama chạy trong chính stack này — không tốn phí theo token, và service khởi động
# được mà không cần khoá của nhà cung cấp trả phí nào. Bật container mô hình bằng hồ sơ riêng:
#
#   docker compose -f deploy/compose/prod.yml --profile ai-local up -d
#   docker compose -f deploy/compose/prod.yml exec ollama ollama pull qwen2.5:7b-instruct
#   docker compose -f deploy/compose/prod.yml exec ollama ollama pull bge-m3
#
# Chưa pull mô hình thì mọi lượt chat trả 503 "trợ lý đang bận" — hướng hỏng đúng, nhưng không tự
# khỏi. Dùng dịch vụ trả phí thì đặt AI_PROVIDER=anthropic và điền CẢ HAI khoá dưới đây: thiếu một
# trong hai, service từ chối khởi động (Claude không có endpoint nhúng, nên Voyage là bắt buộc).
AI_PROVIDER=local
# local | anthropic | none — nhà cung cấp VECTOR NHÚNG, tách khỏi AI_PROVIDER ở trên.
# Trống = đi theo AI_PROVIDER. Có khoá Anthropic mà không có khoá Voyage thì đặt `local`:
# Claude trả lời, bge-m3 nhúng tại chỗ (cần profile ai-local). `none` tắt hẳn tri thức nền.
EMBEDDING_PROVIDER=
OLLAMA_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_MEMORY=8g
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

{
  "realm": "nexaticket",
  "enabled": true,
  "displayName": "NexaTicket",
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "SUPER_ADMIN",
        "description": "Nền tảng: tạo/khoá tổ chức, toàn quyền trên tiền (ADR-1010)"
      },
      {
        "name": "ORG_MEMBER",
        "description": "Thuộc ít nhất một tổ chức; vai trò cụ thể lấy từ identity-service"
      },
      {
        "name": "CUSTOMER",
        "description": "Khách mua vé"
      }
    ]
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    }
  ],
  "clients": [
    {
      "clientId": "web-customer",
      "name": "NexaTicket — Khách hàng",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-secret-customer",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak",
        "http://localhost:3000/api/auth/callback/keycloak-register"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+##http://localhost:3000/##http://localhost:3000/login"
      }
    },
    {
      "clientId": "web-admin",
      "name": "NexaTicket — Tổ chức",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-secret-admin",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3001/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+##http://localhost:3001/##http://localhost:3001/login"
      }
    },
    {
      "clientId": "web-platform",
      "name": "NexaTicket — Superadmin",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-secret-platform",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3003/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3003"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+##http://localhost:3003/##http://localhost:3003/login"
      }
    },
    {
      "clientId": "web-scanner",
      "name": "NexaTicket — Soát vé",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-secret-scanner",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3002/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3002"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+##http://localhost:3002/##http://localhost:3002/login"
      }
    }
  ],
  "users": [
    {
      "username": "superadmin",
      "email": "superadmin@nexaticket.local",
      "firstName": "Super",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",

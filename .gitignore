# --- Java / Maven ---
target/
*.class
# Wrapper dạng script, không có jar binary — commit để ai clone về cũng build được ngay.
!.mvn/wrapper/maven-wrapper.properties

# --- Node ---
node_modules/
.next/
.turbo/
dist/
*.tsbuildinfo
.pnpm-store/

# --- Env & secrets ---
.env
.env.local
.env.*.local
!.env.example

# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# --- Runtime ---
logs/
*.log

# Frontend có repo riêng: github.com/uchihathien/Concert-Ticket-Frontend
# Giữ ở đây để chạy local, nhưng KHÔNG version ở repo này (tránh hai lịch sử phân kỳ).
/frontend/

# Bản sao lưu database. Chúng chứa dữ liệu người dùng thật và mỗi file hàng chục MB — không có
# thứ gì trong đó thuộc về lịch sử mã nguồn.
/deploy/compose/backups/

# Python bytecode của script tiện ích trong scripts/
__pycache__/
*.pyc

# Ticketbox: môi trường ảo và dữ liệu cào, không đưa lên git
scripts/ticketbox/.venv/
scripts/ticketbox/data/
scripts/ticketbox/.pytest_cache/

# Ảnh chụp giao diện chỉ để xem ở máy, không đưa lên git
docs/screenshots/

# Bộ dữ liệu nghiên cứu Ticketbox: dữ liệu cào và môi trường ảo, không đưa lên git
research/forecast-data/data/
research/forecast-data/.venv/
research/forecast-data/.pytest_cache/
research/forecast-data/models/
# File làm việc có dữ liệu lấy từ Ticketbox (đối chiếu nhãn, bản in dữ liệu): repo public, không đưa lên git
research/doi_chieu_nhan_thu_cong.xlsx
research/*.pdf
# Bản sao lưu tạm của bài báo
research/*.bak

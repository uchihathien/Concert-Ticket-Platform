<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nexaticket</groupId>
  <artifactId>nexaticket-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>NexaTicket</name>
  <description>Nền tảng bán vé sự kiện — kiến trúc v2 (microservices + DDD)</description>

  <modules>
    <module>platform</module>
    <module>services</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <spring-boot.version>3.5.0</spring-boot.version>
    <spring-cloud.version>2025.0.0</spring-cloud.version>
    <!-- Testcontainers do spring-boot-dependencies quan ly (BOM khai truoc thi thang).
         Khong khai lai o day: se tao ao giac dieu khien duoc phien ban. -->
    <archunit.version>1.3.0</archunit.version>
    <assertj.version>3.27.2</assertj.version>
    <spotless.version>2.44.2</spotless.version>
    <compiler-plugin.version>3.13.0</compiler-plugin.version>

    <!--
      Docker Engine 25+ dat MinAPIVersion = 1.40 va tu choi ban thap hon bang HTTP 400 khong
      kem thong bao. docker-java (ben trong Testcontainers) mac dinh thuong luong 1.32, nen
      moi container deu hong voi loi "Could not find a valid Docker environment".
      Ep san bang system property; 1.41 la muc an toan nhat: thoa engine moi va van chay
      duoc voi Docker 20.10 tro len.
    -->
    <docker.api.version>1.41</docker.api.version>
    <surefire.version>3.5.2</surefire.version>
    <failsafe.version>3.5.2</failsafe.version>
    <jacoco.version>0.8.12</jacoco.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Module nội bộ: khai version một chỗ duy nhất -->
      <dependency>
        <groupId>com.nexaticket</groupId>
        <artifactId>shared-kernel</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nexaticket</groupId>
        <artifactId>starter-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nexaticket</groupId>
        <artifactId>starter-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nexaticket</groupId>
        <artifactId>starter-outbox</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nexaticket</groupId>
        <artifactId>starter-idempotency</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nexaticket</groupId>
        <artifactId>starter-test</artifactId>
        <version>${project.version}</version>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <!-- *IT là integration test, chạy ở phase riêng bằng failsafe -->
            <excludes><exclude>**/*IT.java</exclude></excludes>
            <!--
              Windows, repo ở ổ khác ổ chứa thư mục temp (F: vs C:):
              Surefire dựng một manifest-JAR chứa classpath rồi relativize hai đường dẫn
              khác ổ đĩa, ném "'other' has different root" và hỏng ngay ở bước discovery.
              Truyền classpath trực tiếp thay vì qua manifest-JAR để tránh hẳn.
            -->
            <useSystemClassLoader>false</useSystemClassLoader>
            <argLine>-Dapi.version=${docker.api.version}</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${failsafe.version}</version>
          <configuration>
            <useSystemClassLoader>false</useSystemClassLoader>
            <argLine>-Dapi.version=${docker.api.version}</argLine>
            <!--
              spring-boot-maven-plugin:repackage biến jar thành fat jar, class ứng dụng nằm dưới
              BOOT-INF/classes. Failsafe mặc định đặt jar đó lên classpath nên không thấy class
              nào -> "failed to discover tests". Trỏ thẳng vào thư mục class đã biên dịch.
            -->
            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
          </configuration>
          <executions>
            <execution>
              <goals><goal>integration-test</goal><goal>verify</goal></goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler-plugin.version}</version>
        <configuration>
          <compilerArgs>
            <arg>-parameters</arg>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat/>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
            <licenseHeader><content>// SPDX-License-Identifier: UNLICENSED</content></licenseHeader>
          </java>
        </configuration>
        <executions>
          <execution>
            <!-- CI job `lint` gọi `mvn spotless:check`; build thường chỉ kiểm ở phase validate -->
            <goals><goal>check</goal></goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.nexaticket</groupId>
    <artifactId>platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>starter-idempotency</artifactId>
  <name>starter-idempotency</name>
  <description>Idempotency-Key cho mutation + processed_events cho consumer</description>

  <dependencies>
    <dependency>
      <groupId>com.nexaticket</groupId>
      <artifactId>starter-web</artifactId>
    </dependency>
    <!-- IdempotencyFilter: servlet API và TenantContext (khoá có phạm vi theo người dùng). provided:
         service nào dùng filter thì đã có sẵn cả hai; consumer thuần AMQP không bị kéo thêm. -->
    <dependency>
      <groupId>com.nexaticket</groupId>
      <artifactId>starter-security</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- ConsumedEvent boc header cua message AMQP va parse JSON.
         scope provided: service nao dung consumer thi da co san amqp va jackson;
         service khong dung thi khong bi keo them dependency thua. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Mockito, Testcontainers PostgreSQL và PostgresSingleton cho test của module này. -->
    <dependency>
      <groupId>com.nexaticket</groupId>
      <artifactId>starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- *IT.java chạy ở phase integration-test, giống services/pom.xml. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

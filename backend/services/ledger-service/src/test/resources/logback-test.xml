<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cấu hình log cho test.

  Testcontainers ghi ở mức DEBUG lý do nó loại từng chiến lược dò Docker. Không bật thì khi
  hỏng chỉ nhận được "Could not find a valid Docker environment" mà không biết vì sao —
  chẩn đoán rất tốn thời gian.
-->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%X{correlationId:-}] %logger{40} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="org.testcontainers" level="DEBUG"/>
  <logger name="com.github.dockerjava" level="INFO"/>
  <logger name="org.testcontainers.dockerclient" level="TRACE"/>

  <logger name="com.nexaticket" level="DEBUG"/>
  <logger name="org.springframework" level="WARN"/>
  <logger name="org.flywaydb" level="INFO"/>

  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>

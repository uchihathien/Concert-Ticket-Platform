<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.nexaticket</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>realtime-gateway</artifactId>
  <name>realtime-gateway</name>
  <description>Giu WebSocket cua khach, day AvailabilityChanged. Khong co database.</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <!-- BAT BUOC du service nay khong validate request nao.
         starter-web khai spring-boot-starter-validation o scope `provided`, nghia la moi consumer
         phai tu cung cap luc chay. Ma GlobalExceptionHandler cua starter-web thi KHONG tuy chon:
         no duoc scan o moi service qua scanBasePackages, va no tham chieu truc tiep
         jakarta.validation.ConstraintViolationException.
         Thieu dependency nay thi service KHONG KHOI DONG DUOC:
           Failed to introspect Class [com.nexaticket.platform.web.error.GlobalExceptionHandler]
           Caused by: ClassNotFoundException: jakarta.validation.ConstraintViolationException
         Loi chi lo ra luc chay - no bien dich duoc va test duoc. 10 service khac da khai san nen
         khong ai thay; realtime-gateway la cai duy nhat khong khai. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
  </dependencies>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.nexaticket</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>api-gateway</artifactId>
  <name>api-gateway</name>
  <description>Route, xác thực JWT, rate limit, correlation id. Không chứa business logic.</description>

  <dependencies>
    <!--
      Gateway chạy trên WebFlux (Netty), khác các service nghiệp vụ dùng Spring MVC.
      Vì vậy phải loại spring-boot-starter-web thừa kế từ pom cha.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
    </dependency>

    <!-- Gateway trước đây không có phụ thuộc test nào, nên cũng không có test nào: rate limit,
         CORS và bảng route đều chưa từng được kiểm. Cả ba đều là ranh giới bảo mật. -->
    <dependency>
      <groupId>com.nexaticket</groupId>
      <artifactId>starter-test</artifactId>
    </dependency>
  </dependencies>
</project>

# Sao chép thành .env và chỉnh nếu cần. KHÔNG commit .env.
# Giá trị ở đây chỉ dùng cho môi trường local — mọi secret thật nằm ở secret manager.

# --- Hạ tầng local (khớp deploy/compose/infra.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/identity_db
DB_USER=identity
DB_PASSWORD=identity
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=nexaticket
RABBITMQ_PASSWORD=nexaticket
OIDC_ISSUER=http://localhost:8081/realms/nexaticket

# Bí mật dùng chung giữa các service khi gọi Open Host Service (/internal/**).
#
# CÙNG MỘT GIÁ TRỊ cho mọi service — đây là hàng rào "người gọi có nằm trong hệ thống không", không
# phải danh tính của từng service. Trống thì filter không được cắm vào và /internal/** mở cho bất
# kỳ ai đứng trong mạng nội bộ; ở production điều đó là không chấp nhận được, vì
# /internal/memberships tạo được người dùng với email tuỳ ý và SuperAdminBootstrap cấp SUPER_ADMIN
# theo email.
NEXATICKET_INTERNAL_SHAREDSECRET=

# --- Frontend ---
# KHÔNG đặt ở file này: mỗi app là một tiến trình riêng và đọc .env.local của chính nó
# (frontend/apps/<app>/.env.local). Bốn app = bốn client Keycloak = bốn bộ giá trị.
#
# AUTH_URL phải đúng cổng của app, và nó là nguồn chân lý duy nhất cho việc cookie có mang tiền tố
# `__Secure-` hay không.
#
# AUTH_SECRET phải KHÁC NHAU giữa bốn app. Cả bốn chạy trên cùng host `localhost` ở dev, mà cookie
# thì không phân biệt cổng: dùng chung secret nghĩa là app này giải mã và ghi đè được phiên của app
# kia. Tên cookie đã tách theo app (packages/auth/src/cookies.ts), secret riêng là hàng rào thứ hai.
#
#   AUTH_URL=http://localhost:3000        # 3000 khách · 3001 tổ chức · 3002 soát vé · 3003 nền tảng
#   AUTH_SECRET=<mỗi app một giá trị>
#   KEYCLOAK_ISSUER=http://localhost:8081/realms/nexaticket
#   KEYCLOAK_CLIENT_ID=web-customer       # trùng clientId trong deploy/keycloak/nexaticket-realm.json
#   KEYCLOAK_CLIENT_SECRET=dev-secret-customer

# --- Cổng thanh toán payOS (ADR-0016) ---
# payOS KHÔNG có môi trường sandbox: mọi lần gọi đi vào hệ thống thật. Để chạy local mà không tốn
# tiền, giữ PAYMENT_SANDBOX=true và dùng POST /internal/payment-intents/{orderId}/simulate-transfer.
#
# Mặc định trong application.yml là FALSE — quên khai biến này ở production thì cửa vẫn đóng. Dòng
# dưới đây MỞ nó, và nó chỉ đúng cho máy phát triển: bật ở production là máy phát vé miễn phí.
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYMENT_SANDBOX=true

# URL payOS gọi khi tiền vào. PHẢI là HTTPS và gọi được TỪ INTERNET, nên localhost không dùng được:
# ở máy phát triển cần một tunnel (ngrok/cloudflared), hoặc bỏ qua webhook và dùng
# POST /internal/payment-intents/{orderId}/reconcile để kéo trạng thái về.
# Đăng ký một lần cho mỗi môi trường: POST /internal/payos/confirm-webhook
PAYOS_WEBHOOK_URL=

# --- Secret thật: KHÔNG bao giờ có giá trị ở file này ---
# PAYOS_CHECKSUM_KEY là secret NẶNG NHẤT của hệ thống: ai biết nó thì giả được một webhook
# "đã trả tiền", và webhook đó là thứ duy nhất đứng giữa internet với việc phát vé thật.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
TICKET_QR_SIGNING_KEY=
BANK_ACCOUNT_ENCRYPTION_KEY=

# --- Trợ lý hỗ trợ khách hàng (ai-chatbox-service) ---
#
# `local` dùng Ollama chạy trên máy/cụm của chính mình — không tốn phí theo token, và service
# khởi động được mà không cần khoá của nhà cung cấp trả phí nào. Đây là mặc định, có chủ đích:
# chat hỗ trợ chạy suốt ngày, và một mặc định có tính tiền nghĩa là mọi môi trường dev đều ghi
# vào hoá đơn thật.
#
# Đổi sang `anthropic` ở nơi cần chất lượng cao hơn. Mô hình 7B gọi tool kém tin cậy hơn hẳn, và
# hậu quả là tỷ lệ chuyển sang bàn hỗ trợ cao hơn — chứ không phải câu trả lời sai.
AI_PROVIDER=local

# Chuẩn bị máy — một trong hai cách:
#   a) Cài Ollama trên host:  ollama pull qwen2.5:7b-instruct && ollama pull bge-m3
#   b) Chạy trong compose:    docker compose -f deploy/compose/infra.yml --profile ai up -d ollama
#      rồi `docker compose ... exec ollama ollama pull <model>` cho cả hai mô hình.
# Hồ sơ `ai` tách riêng vì ảnh cộng mô hình là ~6GB — không ai nên tải chúng chỉ để chạy phần còn
# lại của hệ thống. Chưa có mô hình thì khung chat trả 503, các service khác không ảnh hưởng.
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
# bge-m3 sinh vector 1024 chiều — ĐÚNG BẰNG cột vector(1024) đã khai cho voyage-3.5. Đổi sang mô
# hình số chiều khác thì phải đổi cột VÀ nhúng lại toàn bộ kho tri thức.
OLLAMA_EMBEDDING_MODEL=bge-m3

# Chỉ cần khi AI_PROVIDER=anthropic. Để trống thì khối cấu hình ấy không được dựng.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Kho ảnh bìa sự kiện (MinIO / S3) ---
#
# Trình duyệt tải ảnh THẲNG lên kho bằng URL đã ký — byte không đi qua backend. Hệ quả: kho phải
# gọi được từ trình duyệt, và hai địa chỉ dưới đây KHÁC NHAU.
#
#   MEDIA_ENDPOINT   : catalog-service gọi qua mạng nội bộ (trong compose là `http://minio:9000`).
#   MEDIA_PUBLIC_URL : trình duyệt gọi. Chữ ký bao gồm cả tên host, nên khai nhầm thành tên
#                      container sẽ cho ra URL vừa không phân giải được vừa sai chữ ký.
#
# Ở máy phát triển hai địa chỉ trùng nhau nên để mặc định là đủ.
MEDIA_ENDPOINT=http://localhost:9000
MEDIA_PUBLIC_URL=http://localhost:9000
MEDIA_BUCKET=nexaticket-media
MEDIA_ACCESS_KEY=nexaticket
MEDIA_SECRET_KEY=nexaticket-dev-secret

# Cho phép ban tổ chức dán đường dẫn ảnh từ nơi khác.
#
# Bật ở máy phát triển vì dữ liệu mẫu trỏ ra picsum.photos. Ở production nên đặt false: mọi khách
# xem trang tải ảnh thẳng từ host đó, nên host ấy thấy được IP của từng người — và ảnh biến mất
# vào ngày chủ host dọn dẹp, không ai báo.
MEDIA_ALLOW_EXTERNAL_URLS=true

# Chỉ dùng ở prod.yml: danh sách origin được phép GỬI ảnh lên. `*` nghĩa là bất kỳ trang nào trên
# internet cũng dùng được URL ký sẵn mà nó lấy được.
MEDIA_CORS_ORIGIN=https://admin.nexaticket.vn
